 else{main.className='home';main.innerHTML='<section class="hero"><p class="eyebrow">ONE HOME FOR LIFE’S MANY NEEDS</p><h1>What do you need <em>help with?</em></h1><p class="desc">Explore life areas, free action tools, Human Literacy lessons and TEAL. Paid ideas are previews only.</p><form class="search" id="finder" role="search"><label for="term" class="sr">Search every service</label><input id="term" type="search" autocomplete="off" placeholder="Search any need: bills, jobs, caregiving, business…"><button type="submit">Find help</button></form><div class="results" id="results" hidden></div></section><section><div class="section-title"><h2>Explore every part of life</h2><small>18 areas · 72 ways to start</small></div><div class="grid">'+source.map(a=>'<a class="tile" href="'+uArea(a[0])+'" aria-label="'+esc(a[0])+', four options"><span class="emoji" aria-hidden="true">'+a[1]+'</span><strong>'+esc(quickNames[a[0]]||a[0].replace(' & ',' + '))+'</strong><small>4 ways to begin</small><span class="arrow" aria-hidden="true">↗</span></a>').join('')+'</div></section>';let hits=[];const input=$('term'),results=$('results');const update=()=>{let text=input.value.trim().toLowerCase();if(!text){results.hidden=true;results.innerHTML='';hits=[];return}hits=all.filter(x=>(x.title+' '+x.area).toLowerCase().includes(text)).slice(0,10);results.hidden=false;results.innerHTML=hits.length?hits.map(x=>'<a href="'+uService(x.id)+'"><strong>'+esc(x.title)+'</strong><small>'+esc(x.area)+' · '+kinds[x.kind]+'</small></a>').join(''):'<p style="padding:8px">No exact result. Try a life area below.</p>'};input.addEventListener('input',update);$('finder').addEventListener('submit',e=>{e.preventDefault();if(hits.length)location.href=uService(hits[0].id);else update()});}
