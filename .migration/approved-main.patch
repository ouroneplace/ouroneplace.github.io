+name: Verify deployed ONE PLACE
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  deployed-smoke:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+          cache: npm
+      - run: npm ci
+      - run: npx playwright install --with-deps chromium
+      - run: node scripts/verify_live_site.cjs
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: deployed-one-place-verification
+          path: live-site-report/
+          retention-days: 7
